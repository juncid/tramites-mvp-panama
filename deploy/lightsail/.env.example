# =============================================================================
# Variables de Entorno - MVP Lightsail
# =============================================================================
# Copia este archivo a .env y modifica los valores

# SQL Server
SQL_PASSWORD=YourStrong@Passw0rd
DATABASE_NAME=SIM_PANAMA

# API URL - Usa ruta relativa para que pase por el proxy de Nginx
# Esto permite cerrar el puerto 8000 al exterior
API_URL=/api/v1

# Frontend URL (para CORS) - Tu IP pública o dominio
FRONTEND_URL=http://23.23.20.56

# Opcional: Redis password (dejar vacío para MVP simple)
# REDIS_PASSWORD=
