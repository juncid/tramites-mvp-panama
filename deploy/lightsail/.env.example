# Copia este archivo a .env y modifica los valores

# SQL Server
SQL_PASSWORD=YourStrong@Passw0rd
DATABASE_NAME=SIM_PANAMA

# API URL (cambiar por tu dominio o IP pública de Lightsail)
# Ejemplo: http://123.45.67.89:8000/api/v1
# O con dominio: https://api.tudominio.com/api/v1
API_URL=http://23.23.20.56:8000/api/v1

# Frontend URL (para CORS)
FRONTEND_URL=http://23.23.20.56

# Opcional: Redis password (dejar vacío para MVP simple)
# REDIS_PASSWORD=
