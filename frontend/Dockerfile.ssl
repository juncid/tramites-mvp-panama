# ============================================
# Production Dockerfile con SSL - Multi-stage Optimizado
# ============================================

# ============================================
# Stage 1: Builder - Construcción de la aplicación
# ============================================
FROM node:20-alpine AS builder

# Instalar dependencias del sistema necesarias para build
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Configurar variables de entorno para build optimizado
ENV NODE_ENV=development \
    NPM_CONFIG_LOGLEVEL=error \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

WORKDIR /app

# Copy package files primero (aprovechar cache de Docker)
COPY package.json ./

# Install dependencies  
RUN npm install --no-audit --progress=false && \
    echo "=== $(npm list --depth=0 | wc -l) paquetes instalados ===" && \
    test -f node_modules/.bin/tsc || (echo "ERROR: TypeScript no instalado" && exit 1)

# Copy source code
COPY . .

# Build the application con optimizaciones
ENV PATH="/app/node_modules/.bin:$PATH"
RUN npm run build && \
    rm -rf node_modules && \
    rm -rf src && \
    rm -rf public && \
    rm -rf *.config.* && \
    rm -rf tsconfig.json

# ============================================
# Stage 2: Production - Servidor Nginx con SSL
# ============================================
FROM nginx:1.25-alpine

# Instalar dependencias
RUN apk add --no-cache \
    tini \
    curl \
    openssl \
    && rm -rf /var/cache/apk/*

# Usar tini como init system
ENTRYPOINT ["/sbin/tini", "--"]

# Copiar configuración nginx con SSL
COPY nginx.ssl.conf /etc/nginx/conf.d/default.conf

# Modificar nginx.conf principal para usar pid en /tmp
RUN sed -i 's|pid.*nginx.pid;|pid /tmp/nginx/nginx.pid;|' /etc/nginx/nginx.conf

# Copiar archivos construidos
COPY --from=builder /app/dist /usr/share/nginx/html

# Crear directorios necesarios
RUN mkdir -p /etc/nginx/ssl && \
    mkdir -p /var/www/certbot && \
    mkdir -p /tmp/nginx && \
    mkdir -p /var/run/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /var/run/nginx && \
    chown -R nginx:nginx /tmp/nginx && \
    chmod -R 755 /usr/share/nginx/html

# Expose ports 80 y 443
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/health || curl -fk https://localhost:443/health || exit 1

# Labels
LABEL maintainer="SNMP Panama" \
      description="Frontend con SSL para Trámites MVP Panamá" \
      version="1.0.0"

# Start nginx (como root para poder usar puerto 443)
CMD ["nginx", "-g", "daemon off;"]
